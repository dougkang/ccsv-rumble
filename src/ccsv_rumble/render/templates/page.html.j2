<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow, noarchive">
<title>Week {{ report.week }} Power Rankings</title>
<style>{{ stylesheet | safe }}</style>
</head>
<body>
<!-- provenance: entry={{ entry_id }} algorithm={{ algorithm_version }}{% if draft_algorithm_version %} draft-algorithm={{ draft_algorithm_version }}{% endif %} -->
<header>
  <h1>Power Rankings</h1>
  <p class="meta">
    {{ report.season }} &middot; Week {{ report.week }}
    {%- if not report.is_current_week %} <span class="badge">published late</span>{% endif %}
    {%- if report.is_projection %} <span class="badge">draft-based projection</span>{% endif %}
    {%- if report.is_provisional %} <span class="badge">provisional</span>{% endif %}
  </p>
  {% if report.is_projection %}
  <p class="note">No games have been played yet. This is a projection from drafted rosters, not a power ranking.</p>
  {% elif report.is_provisional %}
  <p class="note">Only one week of results so far, so treat this as provisional — a single week moves these numbers a long way.</p>
  {% endif %}
  {% if report.coverage_note %}
  <p class="note">{{ report.coverage_note }}</p>
  {% endif %}
</header>

<main>
<section aria-labelledby="standings-heading">
  <h2 id="standings-heading" class="section-divider">Standings</h2>
  <table>
    <caption>Week {{ report.week }} power rankings, all {{ report.teams | length }} teams</caption>
    <thead>
      <tr>
        <th scope="col">Rank</th>
        <th scope="col">Team</th>
        <th scope="col">Manager</th>
        <th scope="col">Record</th>
        <th scope="col">Move</th>
      </tr>
    </thead>
    <tbody>
      {%- for team in report.teams %}
      <tr>
        <th scope="row">{{ team.rank }}</th>
        <td>{{ team.team_name }}</td>
        <td>{{ team.manager_display_name }}</td>
        <td>{{ team.record }}</td>
        <td class="move {{ move_class(team) }}">{{ move_label(team) }}</td>
      </tr>
      {%- endfor %}
    </tbody>
  </table>
</section>

{% if article %}
<section aria-labelledby="writeup-heading">
  <h2 id="writeup-heading" class="headline">{{ article.headline }}</h2>
  <p>{{ article.intro }}</p>
  {%- for note in article.team_notes %}
  {%- if note.prose %}
  <p><strong>{{ team_name(note.team_id) }}.</strong> {{ note.prose }}</p>
  {%- endif %}
  {%- endfor %}
  <p>{{ article.outro }}</p>
</section>
{% endif %}

<section aria-labelledby="events-heading">
  <h2 id="events-heading" class="section-divider">Around the league</h2>
  {%- if report.events %}
  <ul class="plain-list">
    {%- for event in report.events %}
    <li>{{ event.summary }}</li>
    {%- endfor %}
  </ul>
  {%- else %}
  <p>A quiet week — no trades, moves, or standout performances to report.</p>
  {%- endif %}
</section>
</main>

<footer>
  <p><a href="index.html">All weeks</a></p>
  <p class="meta">Updated {{ generated_at }}</p>
</footer>
</body>
</html>
