.env
.env.*
credentials.sh
credentials*.sh
*.credentials
secrets.sh

# NOTE: data/*.csv is deliberately NOT ignored -- see specs/004 and the README.
# Capture is an attended step that happens BEFORE the scheduled trigger, and the
# run reads committed data, which is what keeps everything between trigger and
# publish free of a human (constitution, Scheduling). The same league data is
# already public in `archive/` by design, so committing it adds no exposure.
#
# What must NEVER be committed is a PAID source's export. Basketball Monster was
# evaluated and rejected; if a subscription source is ever used, ignore it here.
data/BBM_*.xls
data/BBM_*.csv

# Local render output. `replay --out` / `dry-run --out` target; never published
# from here -- publishing goes through the `pages` branch.
preview/

# macOS
.DS_Store
